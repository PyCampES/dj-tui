Screen {
    background: $surface;
}

#booth {
    width: 100%;
    height: 1fr;
    padding: 1;
}

/* ---- Decks ---- */

.deck {
    width: 1fr;
    height: 100%;
    border: round $accent;
    padding: 1 2;
    margin: 0 1;
}

.deck > .waveform {
    height: 3;
    width: 100%;
    border: round $warning;
    content-align: center middle;
    color: $warning;
    margin-bottom: 1;
}

.deck > .track-name {
    width: 100%;
    height: 1;
    content-align: center middle;
    color: $text-muted;
    margin-bottom: 1;
}

.deck > Button {
    width: 100%;
    margin-bottom: 1;
}

/* ---- Fader vertical de volumen ---- */

#fader {
    width: 11;
    height: 100%;
    border: round $primary;
    padding: 1;
    align: center top;
}

#fader > .vol-btn {
    width: 100%;
    min-width: 5;
}

#vol-bar {
    width: 100%;
    height: 10;
    content-align: center middle;
    color: $success;
    margin: 1 0;
}

#vol-label {
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}
